DISCORD_TOKEN=replace-with-local-token
LOG_LEVEL=info
COMMAND_GUILD_IDS=

# Optional local allowlists. Leave empty to allow any invited guild/channel
# where the bot has Discord permissions. Set comma-separated Discord IDs to
# restrict dynamic pairing to specific guilds or voice channels.
LOCAL_ALLOWED_GUILD_IDS=
LOCAL_ALLOWED_VOICE_CHANNEL_IDS=
